<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mars_world">

    <!-- Mars-like scene: warm ambient, reddish background -->
    <scene>
      <ambient>0.7 0.55 0.4 1</ambient>
      <background>0.55 0.35 0.2 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Directional sun (straight down for even terrain lighting) -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.0 0.0 -1.0</direction>
      <attenuation>
        <range>10000</range>
        <constant>1.0</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <!-- Default camera: aerial view looking down at crater -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -600 500 0 0.6 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Sensors system plugin (needed for IMU/camera/altimeter) -->
    <plugin filename="libgz-sim-sensors-system.so"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- Mars terrain -->
    <include>
      <uri>model://mars_terrain</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Lander (starts at Case 3 initial condition) -->
    <include>
      <uri>model://lander</uri>
      <pose>900 800 2200 0 0 0</pose>
    </include>

  </world>
</sdf>
